{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "RmlUi Unreal",
  "Description": "RmlUi rendering, Web compatibility, and Puerts/Vue integration for Unreal Engine.",
  "Category": "UI",
  "CreatedBy": "RmlUi Unreal integration",
  "CanContainContent": true,
  "Installed": false,
  "SupportedTargetPlatforms": ["Win64"],
  "Modules": [
    {"Name": "RmlUiUnreal", "Type": "Runtime", "LoadingPhase": "PostConfigInit"},
    {"Name": "RmlUiUnrealWebCompat", "Type": "Runtime", "LoadingPhase": "Default"},
    {"Name": "RmlUiUnrealWebCompatPuerts", "Type": "Runtime", "LoadingPhase": "Default"},
    {"Name": "RmlUiUnrealJS", "Type": "Runtime", "LoadingPhase": "Default"},
    {"Name": "RmlUiUnrealEditor", "Type": "Editor", "LoadingPhase": "Default"}
  ],
  "Plugins": [
    {"Name": "Puerts", "Enabled": true}
  ]
}
